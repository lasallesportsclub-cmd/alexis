# Rendus de travail et caches HyperFrames : seuls les livrables vont dans « Pub Meta LA SALLE/ »
renders/
snapshots/
.hyperframes/
node_modules/
*.tmp.*
__pycache__/
# Voix (prises réelles et clonées) : jamais dans ce dépôt public, voir _sources-premium/tools/voix.py
premium-916/*/assets/voix/
premium-45/*/assets/voix/
# LE CUBE « LE CHRONO » : assets recopiés depuis _communs/ par tools/build.py
lecube-chrono/[ABC]/assets/
# Pubs LE CUBE par discipline : photos de personnes, jamais dans ce dépôt public (sources : ~/lecube-sources)
lecube-disciplines/*/assets/
# Musiques des pubs par discipline : régénérées à l'identique par tools/musique.py (graine fixe)
lecube-disciplines/_communs/*.wav
# Stories nutrition : assets recopiés depuis ~/nutri-sources par tools/build.py (photos et visuel partenaire)
lasalle-nutrition-916/assets/
# Fontaine à boisson sportive : assets recopiés par tools/build.py (photo fabricant de la fontaine hors dépôt : ~/fontaine-sources)
lasalle-fontaine/*/assets/
# Musique et bruitages de la story fontaine : régénérés à l'identique par tools/musique.py (graine fixe)
lasalle-fontaine/_communs/*.wav
# Visbody M60 : assets recopiés par tools/build.py (photo fabricant de la machine hors dépôt : ~/visbody-sources)
lasalle-visbody/*/assets/
# Musique et bruitages de la story Visbody : régénérés à l'identique par tools/musique.py (graine fixe)
lasalle-visbody/_communs/*.wav
